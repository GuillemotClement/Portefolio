---
import SkillCol from "./SkillCol.astro";
import SectionHeading from "../Ui/SectionHeading.astro";
import { skillGroups } from "@/data/skills";

const hasLearning = skillGroups.some((group) =>
  group.skills.some((skill) => skill.isLearning),
);
---

<section id="competences" class="bg-night py-16 text-on-night md:py-24">
  <div class="container-page">
    <SectionHeading number="05" label="Compétences" dark>
      <Fragment slot="title">Ma boîte à outils</Fragment>
      Les technologies que j'utilise le plus, du front à la mise en production.
    </SectionHeading>

    <div class="grid border-t border-night-line md:grid-cols-3">
      {skillGroups.map((group, i) => (
        <SkillCol skills={group.skills} title={group.title} index={i + 1} />
      ))}
    </div>

    {
      hasLearning && (
        <p class="mt-7 text-sm text-on-night-muted">
          Les compétences encadrées en <span class="text-lime">citron</span> sont
          en cours d'apprentissage.
        </p>
      )
    }
  </div>
</section>
