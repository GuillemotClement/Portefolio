---
import type { Skill } from "@/types/types";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props as Props;
---

<li
  class:list={[
    "inline-flex items-center gap-2 rounded-md border bg-night-2 px-3 py-1.5 text-sm",
    skill.isLearning ? "border-lime" : "border-night-line",
  ]}
>
  {skill.logo && <img src={skill.logo} alt="" class="h-4.5 w-4.5" loading="lazy" />}
  {skill.title}
  {
    skill.isLearning && (
      <span class="text-[11px] font-bold tracking-[.06em] text-lime uppercase">en cours</span>
    )
  }
</li>
