---
import type { Techno } from '@/types/types';

interface Props {
  skill: Techno
}

const { skill } = Astro.props as Props; 
---

<div class="bg-beige my-3 border-gray-200 border p-3 flex items-center rounded-xl hover:border-accent/40 transition-colors">
  <div class="w-5 h-5 me-4 flex-shrink-0">
    <img src={skill.image} alt={skill.title}/>
  </div>
  <p class="font-bold text-sm">{skill.title}</p>
</div>