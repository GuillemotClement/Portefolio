---
import type { Techno } from '@/types/types';
import SkillItem from './SkillItem.astro';
 
interface Props {
  skills: Techno[],
  title: string;
}

const { skills, title } = Astro.props as Props;
---

<div class="card-surface p-6">
  <h3 class="font-technique font-bold uppercase text-center text-sm tracking-widest text-accent mb-4">{title}</h3>
  <ul>
    {skills.map(skill => (
      <SkillItem skill={skill} />
    ))}
  </ul>
</div>