---
import type { Skill } from "@/types/types";
import SkillItem from "./SkillItem.astro";

interface Props {
  skills: Skill[];
  title: string;
  index: number;
}

const { skills, title, index } = Astro.props as Props;
---

<article class="border-b border-night-line pt-8 pb-9 md:pr-7">
  <div class="num-outline-lime text-[40px]" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </div>
  <h3 class="mt-4.5 mb-4 text-xl tracking-[-0.02em]">{title}</h3>
  <ul class="flex flex-wrap gap-2">
    {skills.map((skill) => <SkillItem skill={skill} />)}
  </ul>
</article>
