---
import { Image } from "astro:assets";
import image from '../../public/heroImage.png'
import { MoveRight, Mail} from '@lucide/astro';

---
<section class="h-200">
  <!-- CONTAINER BLOC -->
  <div class="container mx-auto">
    <!-- CONTENT BLOC -->
    <div class="h-200 flex justify-center items-center ">
      <!-- BLOC TEXT -->
      <div class="h-150 flex flex-col justify-center items-start px-20">
        <h1 class="font-bold text-6xl text-wrap">Clément <br> GUILLEMOT</h1>
        <h2 class="text-primary font-extrabold text-5xl">Développeur <br/> full-stack.</h2>
        <p class="mt-2 mb-5">De la maintenance aéronautique à la conception <br/> d'applications robustes</p>
        
        <div class="flex gap-x-3">
          <a class="btn btn-primary" href="#projects">
            Vois mes projets
            <MoveRight />
          </a>
          <a class="btn btn-ghosty" href="#contact">
            Me Contacter
            <Mail />
          </a>
        </div>
      </div>
      <!-- BLOC IMAGE -->
      <div class="h-150  hidden lg:block">
        <Image src={image} alt="Logo" class="h-150 w-auto" />
      </div>
    </div>
  </div>
</section>