---
<div class="bg-beige py-20" id="contact">
<div class="container mx-auto px-5 grid grid-cols-1 md:grid-cols-2 gap-12" >

    <div class="">
        <h2 class="title-section mb-3">Contact</h2>
        <p class="text-gray-600 mb-8">
            Une question, un projet ou une opportunité à partager ? Écrivez-moi via le formulaire, je réponds dans les meilleurs délais.
        </p>
        <div class="flex gap-4">
            <a href="https://www.linkedin.com/in/cl%C3%A9ment-guillemot/" target="_blank" class="card-surface flex items-center gap-3 px-5 py-4 hover:border-accent/40 transition-colors">
                <i class="fa-brands fa-linkedin text-xl text-accent"></i>
                <div class="">
                    <p class="text-xs text-gray-400 font-technique uppercase">Linkedin</p>
                    <p class="text-sm font-bold">clément-guillemot</p>
                </div>
            </a>

            <a href="https://github.com/GuillemotClement" target="_blank" class="card-surface flex items-center gap-3 px-5 py-4 hover:border-accent/40 transition-colors">
                <i class="fa-brands fa-github text-xl text-accent"></i>
                <div class="">
                    <p class="text-xs text-gray-400 font-technique uppercase">GitHub</p>
                    <p class="text-sm font-bold">GuillemotClement</p>
                </div>
            </a>
        </div>
    </div>


    <form class="card-surface p-8 space-y-4" id="contactForm" method="POST">
        <div class="">
            <label for="name" class="block text-sm font-bold mb-1">Nom</label>
            <input id="name" name="name" type="text" placeholder="Votre nom" class="input w-full">
        </div>

        <div class="">
            <label for="email" class="block text-sm font-bold mb-1">Email</label>
            <input id="email" name="email" type="email" placeholder="vous@email.com" class="input w-full">
        </div>

        <div class="">
            <label for="subject" class="block text-sm font-bold mb-1">Sujet</label>
            <input id="subject" name="subject" placeholder="L'objet de votre message" type="text" class="input w-full">
        </div>

        <div class="">
            <label for="message" class="block text-sm font-bold mb-1">Message</label>
            <textarea id="message" name="content" placeholder="Votre message ..." class="textarea w-full h-32"></textarea>
        </div>

        <input type="text" name="website" style="display: node;">

        <div  id="notification" class="hidden">
        </div>

        <div class="flex justify-end gap-3">
            <button type="reset" class="btn btn-ghost">Réinitialiser</button>
            <button type="submit" class="btn bg-accent text-white border-none hover:opacity-90" id="submitButton">Envoyer le message</button>
        </div>
    </form>
</div>
</div>

<script>
import { sendEmail } from "@/services/mail.service";
import type {MailResponse} from "../services/mail.service"; 

interface FormContact {
    email: string;
    name: string;
    subject: string;
    content: string;
    website: string;
}


const form = document.getElementById("contactForm") as HTMLFormElement;
const submitButton = document.getElementById("submitButton") as HTMLButtonElement;
const containerNotification = document.getElementById("notification") as HTMLDivElement;

form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitButton.disabled = true;
    submitButton.textContent = "Envoi en cours...";

    containerNotification.classList.add('hidden');

    // protection spam simple
    const honey = (document.querySelector('input[name="website"') as HTMLInputElement).value;
    if(honey){
        return;
    }

    const formData = new FormData(form);
    const data = Object.fromEntries(formData) as unknown as FormContact;

    const payload = {
        name: data.name,
        email: data.email,
        subject: data.subject,
        content: data.content
    };

    const result: MailResponse = await sendEmail(payload);

    submitButton.disabled = false;
    submitButton.textContent = "Envoyer le message";

    containerNotification.classList.remove('hidden');

    if(result.success){
        containerNotification.className = "mt-4 p-4 rounded-lg bg-green-100 border border-green-400 text-green-700";
        containerNotification.textContent = "Message envoyé avec succès !";
        form.reset();

        // retire la notif après 5 secondes
        setTimeout(() => {
            containerNotification.classList.add("hidden");
        }, 5000)
    }else{
        containerNotification.className = "mt-4 p-4 rounded-lg bg-red-100 border border-red-400 text-red-700"
        containerNotification.textContent = "Echec de l'envoie du message. Reessayer plus tard";
    }
})


</script>