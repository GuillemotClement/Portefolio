---
import SectionHeading from "./Ui/SectionHeading.astro";
import CtaButton from "./Ui/CtaButton.astro";
import { site } from "@/data/site";

const links = [
  { href: `mailto:${site.email}`, label: "Email", value: site.email, icon: "→", external: false, download: false },
  { href: site.linkedin, label: "LinkedIn", value: site.linkedinLabel, icon: "→", external: true, download: false },
  { href: site.github, label: "GitHub", value: site.githubLabel, icon: "→", external: true, download: false },
  { href: site.cv, label: "CV", value: "Télécharger en PDF", icon: "↓", external: false, download: true },
];
---

<section id="contact" class="py-16 md:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
    <div>
      <SectionHeading number="06" label="Contact" stacked>
        <Fragment slot="title">Parlons de <span class="mark">votre équipe</span>.</Fragment>
        Vous recrutez un développeur full-stack ou back-end ? Écrivez-moi, je
        réponds sous 48 h.
      </SectionHeading>

      <ul class="-mt-6 grid gap-3">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              download={link.download ? site.cvFileName : undefined}
              class="flex items-center justify-between gap-4 rounded-lg border border-line bg-white px-5 py-4 no-underline transition-[border-color,box-shadow] duration-150 hover:border-ink hover:shadow-[4px_4px_0_var(--color-lime)]"
            >
              <span class="min-w-0">
                <small class="block text-xs tracking-widest text-ink-muted uppercase">{link.label}</small>
                <b class="[overflow-wrap:anywhere]">{link.value}</b>
              </span>
              <span aria-hidden="true">{link.icon}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form
      id="contactForm"
      method="POST"
      class="flex flex-col gap-4.5 rounded-[10px] border border-line bg-white p-7"
    >
      <div class="grid gap-4.5 sm:grid-cols-2">
        <div>
          <label for="name" class="mb-1.5 block text-sm font-bold">Nom</label>
          <input id="name" name="name" type="text" autocomplete="name" required placeholder="Marie Dupont" class="field" />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-bold">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required placeholder="marie@entreprise.fr" class="field" />
        </div>
      </div>

      <div>
        <label for="subject" class="mb-1.5 block text-sm font-bold">Sujet</label>
        <input id="subject" name="subject" type="text" required placeholder="Poste de développeur back-end" class="field" />
      </div>

      <!-- Le champ message grandit pour remplir la hauteur du formulaire étiré -->
      <div class="flex flex-1 flex-col">
        <label for="message" class="mb-1.5 block text-sm font-bold">Message</label>
        <textarea id="message" name="content" required placeholder="Présentez le poste ou votre projet" class="field min-h-36 flex-1 resize-y"></textarea>
      </div>

      <!-- Honeypot anti-spam : invisible pour les humains -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="website">Site web</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <p id="notification" role="status" aria-live="polite" class="text-sm text-ink-muted">
          Tous les champs sont requis.
        </p>
        <CtaButton type="submit" variant="night" id="submitButton">Envoyer le message</CtaButton>
      </div>
    </form>
  </div>
</section>

<script>
  import { sendEmail } from "@/services/mail.service";
  import type { MailResponse } from "../services/mail.service";
  import { site } from "@/data/site";

  interface FormContact {
    email: string;
    name: string;
    subject: string;
    content: string;
    website: string;
  }

  const form = document.getElementById("contactForm") as HTMLFormElement;
  const submitButton = document.getElementById("submitButton") as HTMLButtonElement;
  const notification = document.getElementById("notification") as HTMLParagraphElement;

  const BUTTON_LABEL = "Envoyer le message";

  const setNotification = (message: string, state: "info" | "success" | "error") => {
    notification.textContent = message;
    notification.className = {
      info: "text-sm text-ink-muted",
      success: "text-sm font-bold text-green-700",
      error: "text-sm font-bold text-red-700",
    }[state];
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = Object.fromEntries(new FormData(form)) as unknown as FormContact;

    // Protection anti-spam : un robot remplit le champ caché
    if (data.website) {
      form.reset();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Envoi en cours…";
    setNotification("Envoi en cours…", "info");

    const result: MailResponse = await sendEmail({
      name: data.name,
      email: data.email,
      subject: data.subject,
      content: data.content,
    });

    submitButton.disabled = false;
    submitButton.textContent = BUTTON_LABEL;

    if (result.success) {
      setNotification("Message envoyé, merci ! Je vous réponds rapidement.", "success");
      form.reset();
    } else {
      setNotification(`L'envoi a échoué. Réessayez plus tard ou écrivez-moi à ${site.email}.`, "error");
    }
  });
</script>
