---
const { school } = Astro.props;
---

<div class="flex flex-col">
  <div class="flex-1">
    <p>{school.date}</p>
    <div class="">
      <img src={school.image} alt={school.title} height="100" width="100">
    </div>
  </div>

  <div class="flex-1">
    <p>{school.title}</p>
    <p>{school.subtitle}</p>
    <p>{school.city}</p>
  </div>
</div>
