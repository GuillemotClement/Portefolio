---
import type { School } from "@/types/types";

interface Props {
  school: School;
}

const { school } = Astro.props as Props;
---

<li class="flex flex-col gap-2 rounded-[10px] border border-line bg-white p-7">
  {
    school.level && (
      <span class="self-start rounded bg-night px-2.5 py-1.5 text-xs font-bold tracking-[.08em] text-lime uppercase">
        {school.level}
      </span>
    )
  }
  <h3 class="mt-1.5 text-[22px]">{school.title}</h3>
  <p class="text-[15px] text-ink-muted">{school.subtitle} · {school.city}</p>
  <p class="font-mono text-[13px] text-ink-muted">{school.date}</p>
  {
    school.skills && school.skills.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-3" aria-label="Technologies apprises">
        {school.skills.map((skill) => (
          <li class="rounded-full border border-line px-2.5 py-1 text-[13px]">{skill}</li>
        ))}
      </ul>
    )
  }
</li>
