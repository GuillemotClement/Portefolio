---
import ExperienceCard from "./ExperienceCard.astro";
import SectionHeading from "../Ui/SectionHeading.astro";
import { experiences } from "@/data/experiences";
---

<section id="parcours" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading number="03" label="Parcours">
      <Fragment slot="title">Du hangar au code</Fragment>
      Mes expériences professionnelles, de la plus récente à la plus ancienne.
    </SectionHeading>

    <ol class="steps ml-4.5 border-l-2 border-line">
      {experiences.map((experience) => <ExperienceCard experience={experience} />)}
    </ol>
  </div>
</section>
