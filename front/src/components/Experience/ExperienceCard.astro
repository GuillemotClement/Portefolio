---
const { experience } = Astro.props;
---

<div class="flex">
  <div class="flex-1">
    <p>{experience.enterprise}</p>
    <p>{experience.date}</p>
    <p>{experience.city}</p>
    <div class="">
      <img src={experience.src} alt={experience.entreprise}>
    </div>
  </div>

  <div class="flex-1">
    <h3>{experience.title}</h3>
    <ul>
      {experience.tasks.map(task => ( 
        <li>{task}</li>
      ))}
      <li></li>
    </ul>
  </div>
</div>