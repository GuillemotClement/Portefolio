---
import {Image } from "astro:assets";
import logo from "../../public/logo.png"
---

<header class="navbar bg-base-100 shadow-sm">
  <div class="flex-1 flex items-center text-xl gap-x-2">
    <Image src={logo} alt="Logo" class="h-10 w-auto" />
    <p class="">GUILLEMOT Clément</p>
  </div>

  <!-- Navigation desktop > 768px -->
  <nav class="hidden xl:flex items-center gap-6">
    <ul class="menu menu-horizontal px-1">
      <li><a href="#about" class="hover:text-accent">À propos</a></li>
			<li><a href="#experience" class="hover:text-accent">Expériences</a></li>
			<li><a href="#formation" class="hover:text-accent">Formations</a></li>
			<li><a href="#skill" class="hover:text-accent">Compétences</a></li>
			<li><a href="#project" class="hover:text-accent">Projets</a></li>
			<li><a href="#contact" class="hover:text-accent">Contact</a></li>
    </ul>
  </nav>

  <div class="dropdown dropdown-end xl:hidden">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full flex items-center justify-center">
          <svg aria-label="More" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-5 w-5 stroke-current"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path> </svg>
        </div>
      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
        <li><a href="#about" class="hover:text-accent">À propos</a></li>
        <li><a href="#experience" class="hover:text-accent">Expériences</a></li>
        <li><a href="#formation" class="hover:text-accent">Formations</a></li>
        <li><a href="#skill" class="hover:text-accent">Compétences</a></li>
        <li><a href="#project" class="hover:text-accent">Projets</a></li>
        <li><a href="#contact" class="hover:text-accent">Contact</a></li>
      </ul>
  </div>
</header>