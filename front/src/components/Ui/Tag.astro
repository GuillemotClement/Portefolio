---
interface Props {
  title: string;
  variant?: "night" | "light";
}

const { title, variant = "night" } = Astro.props;
---

<li
  class:list={[
    "rounded px-2.5 py-1.5 text-xs font-bold tracking-[.08em] whitespace-nowrap uppercase",
    variant === "night"
      ? "bg-night text-lime"
      : "border border-line bg-soft text-ink-muted",
  ]}
>
  {title}
</li>
