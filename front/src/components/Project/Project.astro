---
import ProjectCard from "./ProjectCard.astro";

import { getExpandCollectionRecords } from "../../services/pocketbase.service";
import type { Project } from "../../types/types"

const projects = await getExpandCollectionRecords<Project>('project',  'techno_id,status_id');

---
<div class="container mx-auto" id="project">

	<h2>Projects</h2>
	<div class="flex justify-between">
		<h3>Sélection de projets</h3>
		<p>Réalisations personelles & pédagogique</p>
	</div>


	{projects.map(project => (
		<ProjectCard project={project} reversed={project.order % 2 === 1}/>
	))}
</div>
