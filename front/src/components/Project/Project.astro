---
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "../Ui/SectionHeading.astro";

import { projects } from "@/data/projects";
---

<section id="projets" class="border-y border-line bg-soft py-16 md:py-24">
  <div class="container-page">
    <SectionHeading number="02" label="Projets">
      <Fragment slot="title">Ce que j'ai construit</Fragment>
      Des applications métier en alternance, un projet d'équipe pour mon titre
      CDA, et des projets personnels nés de vrais besoins, du web à
      l'embarqué.
    </SectionHeading>

    <ul class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </div>
</section>
