---
import Tag from "../Ui/Tag.astro";

import type { Project, Status, Techno } from "../../types/types";

// convention typage Astro 
interface Props {
  project: Project;
  reversed?: boolean;
}

const { project, reversed } = Astro.props as Props;

const status: Status[] = project.expand.status_id;
const features: string[] = project.features;
const technos: Techno[] = project.expand.techno_id;


---

<div class={`border border-gray-300 my-3 flex ${reversed ? 'flex-row-reverse' : ''}`}>
  <div class="flex-1">
    <img src={project.image} alt={project.title}  />\
  </div>
  <div class="flex-1">
    <div class="flex justify-between">
      <h3>{project.title}</h3>
      <ul class="flex gap-x-3">
        {status.map((tag) => (
          <Tag title={tag.title} />
        ))}
      </ul>
    </div>

    <p>{project.description}</p>

    <div class="">
      <h4>Raisons</h4>
      <p>{project.reason}</p>
    </div>

    <h4>Fonctionnalités</h4>
    <ul>
      {features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>

    <ul>
      {technos.map(techno => (
        <Tag title={techno.title} />
      ))}
    </ul>

    <div class="">
      <a href={project.image} target="_blank">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        Voir le site</a>
      <a href={project.github} target="_blank">
        <i class="fa-brands fa-github"></i>
        Code source
      </a>
    </div>

  </div>
</div>