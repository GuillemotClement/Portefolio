---
import Tag from "../Ui/Tag.astro";

import type { Project, Status, Techno } from "../../types/types";
import { parseContent } from "../../utils/parse";

// convention typage Astro 
interface Props {
  project: Project;
  reversed?: boolean;
}

const { project, reversed } = Astro.props as Props;

const status: Status[] = project.expand.status_id;
const features: string[] = project.features;
const technos: Techno[] = project.expand.techno_id;

---

<div class={`border border-gray-300 rounded-2xl flex ${reversed ? 'flex-row-reverse' : ''} mb-10 items-center bg-beige`}>

  <div class="flex-1 border">
    <div class="">
      <p>{project.url}</p>
    </div>
    <img src={project.image} alt={project.title}  />
  </div>

  <div class="flex-1 border p-5">

    <div class="flex justify-between border">
      <h3 class="font-title text-2xl font-bold">{project.title}</h3>
      <ul class="flex gap-x-5">
        {status.map((tag) => (
          <Tag title={tag.title} />
        ))}
      </ul>
    </div>

    <p class="my-3">{parseContent(project.description)}</p>

    <h4 class="text-gray-500 font-bold">Fonctionnalités</h4>
    <ul class="list-disc ps-4 mb-3">
      {features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>

    <div class="flex mb-3">
      {technos.map(techno => (
        <Tag title={techno.title} />
      ))}
    </div>

    <div class="">
      <a href={project.image} target="_blank">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        Voir le site</a>
      <a href={project.github} target="_blank">
        <i class="fa-brands fa-github"></i>
        Code source
      </a>
    </div>

  </div>
</div>