---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e0f1a" />
    <meta name="generator" content={Astro.generator} />
    <title>Clément Guillemot · Développeur full-stack</title>
    <meta
      name="description"
      content="Portfolio de Clément Guillemot, développeur full-stack et ancien technicien de maintenance aéronautique. React, NestJS, TypeScript, PHP."
    />
    <!-- SCRIPT UMAMI -->
    <script
      defer
      src="https://umami.clementguillemot.fr/script.js"
      data-website-id="e2948100-1eb8-4703-9624-12233dcba3be"></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
