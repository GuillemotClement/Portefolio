{% extends 'base.html.twig' %}

{% block body %}
<div class="container mx-auto border  flex justify-center items-center min-h-screen">
    <form action="{{ path('app_login') }}" method="post" class="flex flex-col">

        <label class="input mb-5" for="username">
            <span  class="label">Username:</span>
            <input type="text" class="input" id="username" name="_username" value="{{ last_username }}" required>
        </label>

        <label class="input" for="password">
            <span class="label">Mot de passe</span>
            <input type="password" class="input" id="password" name="_password" required>
        </label>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        {% if error %}
            <div class="text-red-500 text-center italic mt-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="flex justify-center gap-x-4 my-5">
            <button type="reset" class="btn btn-secondary">Reset</button>
            <button type="submit" class="btn btn-primary">login</button>
        </div>
    </form>
</div>
{% endblock %}
